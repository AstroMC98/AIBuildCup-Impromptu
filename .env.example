# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Sign-in. dev: type any name and email (local only). firebase: Google / email via Firebase.
AUTH_MODE=dev
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=            # the Firebase web app's API key (public)
# FIREBASE_AUTH_DOMAIN=        # defaults to PROJECT.firebaseapp.com

# Who can grant credits and take pods down (comma-separated emails).
ADMIN_EMAILS=

# Credits: creating pods costs this many per minute; new accounts start with SIGNUP_CREDITS.
CREDITS_PER_MINUTE=1
RESEARCH_CREDITS_PER_MINUTE=0.5   # extra per minute for pods with Research on (Google lookups)
SIGNUP_CREDITS=0

# Signs session cookies. Optional locally (one is generated under DATA_DIR).
# Changing it signs everyone out.
SESSION_SECRET=

# Models
SCRIPT_MODEL=gemini-3.8-flash
SCRIPT_THINKING_LEVEL=low
TTS_MODEL=gemini-3.8-flash-tts          # or gemini-3.8-flash-lite-tts: faster, cheaper

# Pacing
SEGMENT_SECONDS=20       # audio per segment: smaller = hosts answer call-ins sooner, more API calls
LINES_PER_SEGMENT=5      # the most lines in one segment
LOW_WATER_SECONDS=8      # audio voiced ahead of the live playhead
MAX_REWRITES=2           # times a ready segment may be redone to fit in new input
MAX_SOURCE_CHARS=400000

# Storage: local writes to DATA_DIR. gcp uses Firestore + Cloud Storage (deploy/deploy.sh sets these).
STORAGE_BACKEND=local
DATA_DIR=data
# GCS_BUCKET=
# GCP_PROJECT=

# Live pods
MAX_LIVE_SHOWS=3         # pods and co-host calls live at once on this server
MAX_LISTENERS=50         # per pod
IDLE_END_SECONDS=300     # nobody listening this long: the hosts sign off

# Co-host live (you talk with an AI co-host; Gemini Live)
COHOST_MODEL=gemini-3.1-flash-live-preview
COHOST_SILENCE_MS=500              # your pause before the co-host answers
COHOST_RECONNECT_SECONDS=30        # a dropped phone has this long to come back before the call is saved
COHOST_EDIT_TIMEOUT_SECONDS=40     # past this, save without the editor's notes
# Voice memos: a recording in, a finished pod out (researched, scored, mixed)
MEMO_MAX_MB=14           # upload cap (Gemini takes recordings inline, 20 MB per request)
MEMO_MAX_SECONDS=600
MAX_RESEARCH_QUERIES=5   # Google searches per memo
MAX_RENDERS=1            # memo pods voiced at once, next to the live pods; raise once
                         # tests.live_test --memo shows the TTS is fast enough
RENDER_MP3_KBPS=64

# Music: every pod opens on a theme from the library in MUSIC_DIR (empty = no theme).
# Build it once: python tools/build_music_library.py --lyria (or --from-files DIR).
MUSIC_DIR=music
MUSIC_MODEL=lyria-3-clip-preview   # original music for memo pods; empty turns it off
MUSIC_CREDITS=2                    # what original music costs on top of the minutes
